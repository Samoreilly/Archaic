[Unit]
Description=Archaic path-complete daemon
Documentation=https://github.com/Samoreilly/Archaic

[Service]
Type=simple
ExecStart=%h/.local/bin/archaic --daemon %h %t/archaic.sock
ExecStop=%h/.local/bin/archaic-cli --sock %t/archaic.sock shutdown
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
