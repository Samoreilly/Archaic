[Unit]
Description=Archaic path-complete daemon
Documentation=https://github.com/Samoreilly/Archaic

[Service]
Type=simple
ExecStart=/usr/bin/archaic --daemon %t/archaic.sock
ExecStop=/usr/bin/archaic-cli --sock %t/archaic.sock shutdown
Restart=on-failure
RestartSec=2
WatchdogSec=40
Environment=MALLOC_ARENA_MAX=4

[Install]
WantedBy=default.target
